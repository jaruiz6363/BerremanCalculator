<Project Sdk="Microsoft.NET.Sdk">

  <!-- One API, three front ends: the CLI, the MCP server and the GUI all bind here, so their
       answers to the same question cannot drift apart. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>The BerremanCalculator API: stacks, materials and evaluation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Berreman.Native\Berreman.Native.csproj" />
  </ItemGroup>

</Project>
