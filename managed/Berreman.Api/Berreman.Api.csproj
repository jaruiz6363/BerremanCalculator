<Project Sdk="Microsoft.NET.Sdk">

  <!-- One API, three front ends: the CLI, the MCP server and the GUI all bind here, so their
       answers to the same question cannot drift apart. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Description>The BerremanCalculator API: stacks, materials and evaluation.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Berreman.Native\Berreman.Native.csproj" />
  </ItemGroup>

  <!-- The literature samples, copied beside every program that uses the API, under samples/:
       the GUI lists them, and the CLI and the MCP server can be pointed at them. -->
  <ItemGroup>
    <None Include="..\..\samples\**\*.json" Link="samples\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The material databases and glass catalogues (materials/README.md), beside every program. -->
  <ItemGroup>
    <None Include="..\..\materials\**\*.txt;..\..\materials\**\*.AGF;..\..\materials\README.md" Link="materials\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
