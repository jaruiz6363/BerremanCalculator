<Project Sdk="Microsoft.NET.Sdk">

  <!-- The raw ABI mirror: the native calls, the structs of berreman.h, and the allocation
       primitive. No physics. Everything above builds on this and never re-declares any of it. -->

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsAotCompatible>true</IsAotCompatible>
    <Description>Raw P/Invoke bindings for the BerremanCalculator native engine.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>

</Project>
