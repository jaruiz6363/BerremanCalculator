<Project Sdk="Microsoft.NET.Sdk">

  <!-- The managed suite: an executable with no test framework, as in ThinFilmDesigner, so it builds
       with no network. Exit code 0 means every check passed. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Berreman.Native.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Berreman.Native\Berreman.Native.csproj" />
    <ProjectReference Include="..\Berreman.Api\Berreman.Api.csproj" />
    <ProjectReference Include="..\Berreman.Mcp\Berreman.Mcp.csproj" />
    <ProjectReference Include="..\Berreman.Gui.Core\Berreman.Gui.Core.csproj" />
  </ItemGroup>

  <!-- The literature samples the suite checks, embedded so there is no path to get wrong. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\samples\literature\**\*.berr" LogicalName="samples/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\..\tests\fixtures\**\*.tfd;..\..\tests\fixtures\**\*.json" LogicalName="fixtures/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The OpticStudio user-defined surface example (examples/zemax-uds), built by CMake, which the
       suite calls as OpticStudio does. -->
  <ItemGroup>
    <None Include="..\..\build\**\US_BERREMAN.dll;..\..\build\**\US_BERREMAN.so;..\..\build\**\US_BERREMAN.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <Import Project="..\NativeLibrary.targets" />

</Project>
