<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="using:Berreman.Gui"
        xmlns:core="clr-namespace:Berreman.Gui.Core;assembly=Berreman.Gui.Core"
        x:Class="Berreman.Gui.MainWindow"
        Title="BerremanCalculator"
        Width="1560" Height="900" MinWidth="980" MinHeight="560">

  <Window.Styles>
    <!-- A plain column header, as ThinFilmDesigner's: Fluent reserves 32 px for a sort arrow the
         layer table never shows, since the row order is the stack order. -->
    <Style Selector="DataGridColumnHeader">
      <Setter Property="Padding" Value="6,0,6,0"/>
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Template">
        <ControlTemplate>
          <Grid Background="{TemplateBinding Background}" ColumnDefinitions="*,Auto">
            <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}" Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            <Rectangle Name="VerticalSeparator" Grid.Column="1" Width="1" VerticalAlignment="Stretch"
                       Fill="{TemplateBinding SeparatorBrush}" IsVisible="{TemplateBinding AreSeparatorsVisible}"/>
          </Grid>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="12,4"/>
    </Style>
    <Style Selector="TabItem:selected">
      <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <!-- A table cell: a TextBox that reads as text in a grid, not as a form field. -->
    <Style Selector="TextBox.cell">
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Padding" Value="4,2"/>
      <Setter Property="MinHeight" Value="0"/>
      <Setter Property="TextAlignment" Value="Right"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,0,6,0"/>
    </Style>
    <Style Selector="TextBlock.hint">
      <Setter Property="Foreground" Value="#666"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style Selector="TextBox.angle">
      <Setter Property="Width" Value="64"/>
      <Setter Property="TextAlignment" Value="Right"/>
    </Style>
  </Window.Styles>

  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_File">
        <MenuItem x:Name="NewItem" Header="_New stack" InputGesture="Ctrl+N"/>
        <MenuItem x:Name="OpenItem" Header="_Open…" InputGesture="Ctrl+O"/>
        <MenuItem x:Name="BrowseSamplesItem" Header="_Browse samples…"/>
        <MenuItem x:Name="SamplesItem" Header="Open _sample"/>
        <Separator/>
        <MenuItem x:Name="SaveItem" Header="_Save" InputGesture="Ctrl+S"/>
        <MenuItem x:Name="SaveAsItem" Header="Save _as…" InputGesture="Ctrl+Shift+S"/>
        <Separator/>
        <MenuItem x:Name="ImportTfdItem" Header="_Import a ThinFilmDesigner design (.tfd)…"/>
        <MenuItem x:Name="ImportCoatingItem" Header="Import a _coating from OpticStudio or Optiland…"/>
        <Separator/>
        <MenuItem x:Name="ExportItem" Header="_Export results as CSV…"/>
        <MenuItem x:Name="ExportPlotItem" Header="Export the _plot as PNG…"/>
        <MenuItem x:Name="ExportReportItem" Header="Export a design _report…"/>
        <Separator/>
        <MenuItem x:Name="ExitItem" Header="E_xit"/>
      </MenuItem>
      <MenuItem Header="_Edit">
        <MenuItem x:Name="UndoItem" Header="_Undo" InputGesture="Ctrl+Z"/>
        <MenuItem x:Name="RedoItem" Header="_Redo" InputGesture="Ctrl+Y"/>
      </MenuItem>
      <MenuItem Header="_Stack">
        <MenuItem x:Name="InsertItem" Header="_Insert layer" InputGesture="Insert"/>
        <MenuItem x:Name="DeleteItem" Header="_Delete layer"/>
        <MenuItem x:Name="UpItem" Header="Move _up"/>
        <MenuItem x:Name="DownItem" Header="Move do_wn"/>
        <MenuItem x:Name="PropertiesItem" Header="Layer _properties…"/>
        <Separator/>
        <MenuItem x:Name="ReverseItem" Header="_Reverse layers"/>
        <MenuItem x:Name="ReverseMediaItem" Header="Reverse layers and _media"/>
        <MenuItem x:Name="DeleteAllItem" Header="Delete _all layers…"/>
      </MenuItem>
      <MenuItem Header="_Analysis">
        <MenuItem x:Name="EvaluateItem" Header="_Evaluate" InputGesture="F5"/>
        <MenuItem x:Name="ConoscopeItem" Header="_Conoscopic map…"/>
        <MenuItem x:Name="FieldProfileItem" Header="_Field profile…"/>
        <MenuItem x:Name="AutoItem" Header="Evaluate after every _change" ToggleType="CheckBox" IsChecked="True"/>
      </MenuItem>
    </Menu>

    <Border DockPanel.Dock="Bottom" Padding="8,4" BorderBrush="#DDD" BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <SelectableTextBlock x:Name="StatusText" TextWrapping="Wrap" Text="Ready."/>
        <TextBlock Grid.Column="1" x:Name="EvaluationText" Foreground="#555" Margin="12,0,0,0" MaxWidth="520" TextTrimming="CharacterEllipsis"/>
        <TextBlock Grid.Column="2" x:Name="SummaryText" Foreground="#555" Margin="12,0,0,0"/>
      </Grid>
    </Border>

    <Grid ColumnDefinitions="11*,Auto,9*">
      <TabControl x:Name="Tabs" Grid.Column="0" Margin="4,0,0,0">

        <!-- ===== Stack ========================================================================= -->
        <TabItem Header="Stack">
          <DockPanel>
            <Expander DockPanel.Dock="Top" Header="Description" Margin="4,4,4,0" HorizontalAlignment="Stretch">
              <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,2">
                <TextBlock Classes="label" Text="Title"/>
                <TextBox Grid.Column="1" x:Name="TitleBox" Margin="0,2"/>
                <TextBlock Grid.Row="1" Classes="label" Text="Source"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="SourceBox" Margin="0,2" Watermark="the paper, figure or table this reproduces"/>
                <TextBlock Grid.Row="2" Classes="label" Text="Notes" VerticalAlignment="Top" Margin="0,8,6,0"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="NotesBox" Margin="0,2" AcceptsReturn="True" TextWrapping="Wrap"
                         MinHeight="60" MaxHeight="160" Watermark="assumptions made where the source is incomplete"/>
              </Grid>
            </Expander>

            <!-- Units. Changing one converts every number in it, so the stack stays physically the same. Thicknesses are always physical. -->
            <WrapPanel DockPanel.Dock="Top" Margin="8,6,8,0">
              <TextBlock Classes="label" Text="Lengths in"/>
              <ComboBox x:Name="LengthUnitBox" Width="80" Margin="0,0,16,0"/>
              <TextBlock Classes="label" Text="Spectral axis in"/>
              <ComboBox x:Name="SpectralUnitBox" Width="90"/>
            </WrapPanel>

            <!-- Layer buttons -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="4" Margin="8,8,8,4">
              <Button x:Name="InsertButton" Content="Insert" ToolTip.Tip="Insert a copy of the selected layer after it (Insert)"/>
              <Button x:Name="DeleteButton" Content="Delete" ToolTip.Tip="Delete the selected layers"/>
              <Button x:Name="UpButton" Content="Up" ToolTip.Tip="Move the selected layer towards the incident medium"/>
              <Button x:Name="DownButton" Content="Down" ToolTip.Tip="Move the selected layer towards the exit medium"/>
              <Button x:Name="PropertiesButton" Content="Properties…" ToolTip.Tip="Thickness, orientation and twist of the selected layer"/>
              <Border Width="1" Background="#D0D0D0" Margin="4,2"/>
              <Button x:Name="UndoButton" Content="Undo" ToolTip.Tip="Ctrl+Z"/>
              <Button x:Name="RedoButton" Content="Redo" ToolTip.Tip="Ctrl+Y"/>
            </StackPanel>

            <!-- Incident medium -->
            <Border DockPanel.Dock="Top" Margin="8,2" Padding="6,4" Background="#F3F6FA" CornerRadius="3">
              <WrapPanel>
                <TextBlock Classes="label" Text="Incident medium" FontWeight="SemiBold" Width="120"/>
                <ComboBox x:Name="IncidentBox" MinWidth="160" Margin="0,0,12,0"/>
                <!-- The orientation, shown only when the medium is anisotropic: it does nothing to an isotropic one. -->
                <StackPanel x:Name="IncidentAngles" Orientation="Horizontal">
                  <TextBlock Classes="label" Text="φ"/><TextBox x:Name="IncidentPhi" Classes="angle" Margin="0,0,6,0"/>
                  <TextBlock Classes="label" Text="θ"/><TextBox x:Name="IncidentTheta" Classes="angle" Margin="0,0,6,0"/>
                  <TextBlock Classes="label" Text="ψ"/><TextBox x:Name="IncidentPsi" Classes="angle" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBlock x:Name="IncidentInfo" Classes="hint" VerticalAlignment="Center"/>
              </WrapPanel>
            </Border>

            <!-- Sweep -->
            <Border DockPanel.Dock="Bottom" Margin="8,4,8,8" Padding="6,4" BorderBrush="#DDD" BorderThickness="1" CornerRadius="3">
              <StackPanel Spacing="4">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                  <!-- The spectral sweep as start, end and step, in the unit chosen above. A start
                       alone is one value. -->
                  <TextBlock Classes="label" Text="Spectral" FontWeight="SemiBold" Width="120"/>
                  <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Start"/>
                    <TextBox x:Name="SpectralStartBox" Width="90" Margin="0,2,10,2"/>
                    <TextBlock Classes="label" Text="End"/>
                    <TextBox x:Name="SpectralEndBox" Width="90" Margin="0,2,10,2" Watermark="one value"/>
                    <TextBlock Classes="label" Text="Step"/>
                    <TextBox x:Name="SpectralStepBox" Width="90" Margin="0,2,6,2"/>
                    <TextBlock x:Name="SpectralUnitLabel" Classes="label" Margin="0,0,14,0"/>
                    <TextBlock x:Name="SpectralPoints" Classes="hint" VerticalAlignment="Center"/>
                  </WrapPanel>
                  <ComboBox Grid.Row="1" x:Name="AngleModeBox" Width="114" Margin="0,2,6,2"/>
                  <!-- The angles (or ξ) as start, end and step, like the spectral sweep. -->
                  <WrapPanel Grid.Row="1" Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Classes="label" Text="Start"/>
                    <TextBox x:Name="AngleStartBox" Width="90" Margin="0,2,10,2"/>
                    <TextBlock Classes="label" Text="End"/>
                    <TextBox x:Name="AngleEndBox" Width="90" Margin="0,2,10,2" Watermark="one value"/>
                    <TextBlock Classes="label" Text="Step"/>
                    <TextBox x:Name="AngleStepBox" Width="90" Margin="0,2,6,2"/>
                    <TextBlock x:Name="AngleUnitLabel" Classes="label" Margin="0,0,14,0"/>
                    <TextBlock x:Name="AnglePoints" Classes="hint" VerticalAlignment="Center"/>
                  </WrapPanel>
                  <TextBlock Grid.Row="2" Classes="label" Text="Azimuth (°)" FontWeight="SemiBold"/>
                  <TextBox Grid.Row="2" Grid.Column="1" x:Name="AzimuthBox" Margin="0,2" Watermark="0" Width="200" HorizontalAlignment="Left"/>
                </Grid>
                <TextBlock Classes="hint" Text="A start with no end is one value. The azimuth turns the whole sample about the normal: one value, or a list such as 0, 45, 90."/>
              </StackPanel>
            </Border>

            <!-- Exit medium -->
            <Border DockPanel.Dock="Bottom" Margin="8,2" Padding="6,4" Background="#F3F6FA" CornerRadius="3">
              <WrapPanel>
                <TextBlock Classes="label" Text="Exit medium" FontWeight="SemiBold" Width="120"/>
                <ComboBox x:Name="ExitBox" MinWidth="160" Margin="0,0,12,0"/>
                <StackPanel x:Name="ExitAngles" Orientation="Horizontal">
                  <TextBlock Classes="label" Text="φ"/><TextBox x:Name="ExitPhi" Classes="angle" Margin="0,0,6,0"/>
                  <TextBlock Classes="label" Text="θ"/><TextBox x:Name="ExitTheta" Classes="angle" Margin="0,0,6,0"/>
                  <TextBlock Classes="label" Text="ψ"/><TextBox x:Name="ExitPsi" Classes="angle" Margin="0,0,8,0"/>
                </StackPanel>
                <TextBlock x:Name="ExitInfo" Classes="hint" VerticalAlignment="Center"/>
              </WrapPanel>
            </Border>

            <!-- THE LAYERS. Layer 1 faces the incident medium. Every column but # and the
                 read-only ones edits the stack when the cell is left (or Enter is pressed); the
                 orientation is the Euler angles φ, θ, ψ (contract, Section 1), and "Optic axis"
                 says where the material's own z axis ends up. -->
            <DataGrid x:Name="LayerGrid" Margin="8,2" x:DataType="core:LayerRow"
                      AutoGenerateColumns="False" CanUserSortColumns="False" CanUserReorderColumns="False"
                      GridLinesVisibility="All" HeadersVisibility="Column" SelectionMode="Extended" IsReadOnly="False">
              <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Number}" IsReadOnly="True" Width="44"/>
                <DataGridTemplateColumn Header="Material" Width="140" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <ComboBox ItemsSource="{Binding MaterialOptions}" SelectedItem="{Binding Material}" HorizontalAlignment="Stretch" Margin="2,0"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <!-- What the material is: its type, read from its matrix, and how it disperses. -->
                <DataGridTemplateColumn Header="Type" Width="170" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <TextBlock Text="{Binding TypeText}" ToolTip.Tip="{Binding MaterialSummary}" VerticalAlignment="Center" Margin="4,0" TextTrimming="CharacterEllipsis"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="Thickness" Width="120" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <TextBox Classes="cell" Text="{Binding ThicknessText, UpdateSourceTrigger=LostFocus}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="φ (°)" Width="62" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <TextBox Classes="cell" Text="{Binding Phi, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding Oriented}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="θ (°)" Width="62" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <TextBox Classes="cell" Text="{Binding Theta, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding Oriented}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="ψ (°)" Width="62" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <TextBox Classes="cell" Text="{Binding Psi, UpdateSourceTrigger=LostFocus}" IsVisible="{Binding Oriented}"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Optic axis" Binding="{Binding AxisText}" IsReadOnly="True" Width="128"/>
                <DataGridTextColumn Header="Twist" Binding="{Binding TwistText}" IsReadOnly="True" Width="100"/>
                <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                  <DataGridTemplateColumn.CellTemplate>
                    <DataTemplate x:DataType="core:LayerRow">
                      <Button Classes="layerProperties" Content="…" Padding="8,0" HorizontalAlignment="Center" ToolTip.Tip="Layer properties"/>
                    </DataTemplate>
                  </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="" IsReadOnly="True" Width="18"/>
              </DataGrid.Columns>
            </DataGrid>
          </DockPanel>
        </TabItem>

        <!-- ===== Materials ===================================================================== -->
        <TabItem Header="Materials">
          <Grid ColumnDefinitions="210,*" Margin="4">
            <DockPanel Margin="4">
              <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Button x:Name="NewMaterialButton" Content="New"/>
                  <Button x:Name="DuplicateMaterialButton" Content="Duplicate"/>
                  <Button x:Name="RemoveMaterialButton" Content="Remove"/>
                </StackPanel>
                <Button x:Name="LibraryButton" Content="From library…" HorizontalAlignment="Stretch"/>
                <Button x:Name="SaveToLibraryButton" Content="Save to my materials" HorizontalAlignment="Stretch"/>
              </StackPanel>
              <ListBox x:Name="MaterialList">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="local:MaterialItem">
                    <StackPanel Spacing="1">
                      <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                      <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" FontSize="11" Foreground="#555"/>
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="8,4,4,4">
              <StackPanel DockPanel.Dock="Top" Spacing="6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <TextBlock Classes="label" Text="Name"/>
                  <TextBox x:Name="MaterialNameBox" Width="220"/>
                  <Button x:Name="RenameMaterialButton" Content="Rename"/>
                </StackPanel>
                <TextBlock x:Name="MaterialSummary" TextWrapping="Wrap"/>
                <TextBlock x:Name="MaterialUses" Classes="hint"/>
              </StackPanel>
              <TabControl x:Name="MaterialTabs" Margin="0,6,0,0">

                <!-- The material as people think of it: an index, or one formula, per direction -->
                <TabItem Header="Material">
                  <DockPanel Margin="4">
                    <ScrollViewer x:Name="PlainScroll" DockPanel.Dock="Top" MaxHeight="440" HorizontalScrollBarVisibility="Disabled">
                      <StackPanel x:Name="PlainPanel" Spacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <TextBlock Classes="label" Text="Directions" VerticalAlignment="Center" Width="150"/>
                          <ComboBox x:Name="PlainAxesBox" Width="360">
                            <ComboBoxItem Content="The same in every direction (isotropic)"/>
                            <ComboBoxItem Content="Ordinary and extraordinary (uniaxial)"/>
                            <ComboBoxItem Content="Different along x, y and z (biaxial)"/>
                          </ComboBox>
                        </StackPanel>
                        <StackPanel x:Name="PlainValuesPanel" Spacing="12"/>
                        <StackPanel Orientation="Horizontal" Spacing="6">
                          <Button x:Name="ApplyPlainButton" Content="Apply" FontWeight="SemiBold"/>
                          <Button x:Name="UndoPlainButton" Content="Undo" ToolTip.Tip="Undo the last change (Ctrl+Z)"/>
                        </StackPanel>
                      </StackPanel>
                    </ScrollViewer>
                    <StackPanel DockPanel.Dock="Top" x:Name="NotPlainPanel" Spacing="6">
                      <TextBlock x:Name="NotPlainText" TextWrapping="Wrap"/>
                      <TextBlock Classes="hint" TextWrapping="Wrap" Text="Its details are on the Advanced tab. The plot below is n and k along its principal axes."/>
                      <Button x:Name="MakeSimpleButton" Content="Replace with a constant n, k"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" x:Name="PlainChecks" TextWrapping="Wrap" Margin="0,4,0,0"/>
                    <local:SpectrumPlot x:Name="PlainPlot" MinHeight="200" Margin="0,10,0,0"/>
                  </DockPanel>
                </TabItem>

                <!-- Everything else: terms, the response in detail, the text -->
                <TabItem Header="Advanced">
                  <TabControl x:Name="AdvancedTabs">

                    <!-- The general form: laws times 6x6 shapes -->
                    <TabItem Header="Terms">
                      <Grid RowDefinitions="Auto,*,Auto" Margin="4">
                        <DockPanel>
                          <TextBlock DockPanel.Dock="Top" x:Name="TermsHint" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"/>
                          <WrapPanel DockPanel.Dock="Bottom" Margin="0,4,0,0">
                            <Button x:Name="AddTermButton" Content="Add" Margin="0,0,4,4"/>
                            <Button x:Name="DuplicateTermButton" Content="Duplicate" Margin="0,0,4,4"/>
                            <Button x:Name="DeleteTermButton" Content="Delete" Margin="0,0,4,4"/>
                            <Button x:Name="TermUpButton" Content="Up" Margin="0,0,4,4"/>
                            <Button x:Name="TermDownButton" Content="Down" Margin="0,0,4,4"/>
                          </WrapPanel>
                          <ListBox x:Name="TermList" MaxHeight="190"/>
                        </DockPanel>
                        <ScrollViewer Grid.Row="1" Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled">
                          <StackPanel x:Name="TermEditor" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="label" Text="Label" VerticalAlignment="Center" Width="60"/>
                              <TextBox x:Name="TermLabelBox" Width="260"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="label" Text="Law" VerticalAlignment="Center" Width="60"/>
                              <ComboBox x:Name="TermLawBox" Width="180"/>
                            </StackPanel>
                            <TextBlock x:Name="TermLawFormula" Classes="hint" TextWrapping="Wrap"/>
                            <StackPanel x:Name="LawFieldsPanel" Spacing="4"/>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <TextBlock Classes="label" Text="Shape" VerticalAlignment="Center" Width="60"/>
                              <ComboBox x:Name="ShapeModeBox" Width="260">
                                <ComboBoxItem Content="a direction, by angles"/>
                                <ComboBoxItem Content="a direction, by vector"/>
                                <ComboBoxItem Content="the 6×6 matrix"/>
                                <ComboBoxItem Content="a direction in crystal axes [u v w]"/>
                              </ComboBox>
                            </StackPanel>
                            <StackPanel x:Name="DirectionCrystalPanel" Spacing="4">
                              <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="[u v w]" VerticalAlignment="Center" Width="60"/>
                                <TextBox x:Name="UvwUBox" Width="60"/>
                                <TextBox x:Name="UvwVBox" Width="60"/>
                                <TextBox x:Name="UvwWBox" Width="60"/>
                                <TextBlock Classes="hint" VerticalAlignment="Center" Text="the direction u a + v b + w c"/>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="lattice" VerticalAlignment="Center" Width="60"/>
                                <TextBlock Text="a" VerticalAlignment="Center"/><TextBox x:Name="LatticeABox" Width="64"/>
                                <TextBlock Text="b" VerticalAlignment="Center"/><TextBox x:Name="LatticeBBox" Width="64"/>
                                <TextBlock Text="c" VerticalAlignment="Center"/><TextBox x:Name="LatticeCBox" Width="64"/>
                                <TextBlock Text="α" VerticalAlignment="Center"/><TextBox x:Name="LatticeAlphaBox" Width="56"/>
                                <TextBlock Text="β" VerticalAlignment="Center"/><TextBox x:Name="LatticeBetaBox" Width="56"/>
                                <TextBlock Text="γ" VerticalAlignment="Center"/><TextBox x:Name="LatticeGammaBox" Width="56"/>
                              </StackPanel>
                              <TextBlock Classes="hint" TextWrapping="Wrap"
                                         Text="The lattice belongs to the material and is shared by its terms. It is placed with a along x, b in the x–y plane and c towards +z (docs/material-model.md, Crystal axes); a paper that places it otherwise is matched with the layer's Euler angles."/>
                            </StackPanel>
                            <StackPanel x:Name="DirectionAnglesPanel" Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="angle from x towards y (°)" VerticalAlignment="Center"/>
                              <TextBox x:Name="AxisAngleBox" Width="80"/>
                              <TextBlock Text="elevation towards z (°)" VerticalAlignment="Center"/>
                              <TextBox x:Name="AxisElevationBox" Width="80"/>
                            </StackPanel>
                            <StackPanel x:Name="DirectionVectorPanel" Orientation="Horizontal" Spacing="6">
                              <TextBlock Text="x" VerticalAlignment="Center"/>
                              <TextBox x:Name="AxisXBox" Width="70"/>
                              <TextBlock Text="y" VerticalAlignment="Center"/>
                              <TextBox x:Name="AxisYBox" Width="70"/>
                              <TextBlock Text="z" VerticalAlignment="Center"/>
                              <TextBox x:Name="AxisZBox" Width="70"/>
                            </StackPanel>
                            <TextBlock x:Name="DirectionHint" Classes="hint" TextWrapping="Wrap"
                                       Text="The law is added to ε along this direction ê, as f(λ) ê êᵀ, in the material's own axes. The layer's Euler angles turn the whole material."/>
                            <StackPanel x:Name="ShapeMatrixPanel" Spacing="4">
                              <TextBlock Classes="hint" TextWrapping="Wrap"
                                         Text="Rows and columns are (Ex, Ey, Ez, H̃x, H̃y, H̃z): ε top left, ρ top right, ρ′ bottom left, μ bottom right. Type 2, -0.08, 0.1i or 2+0.1i; empty is 0."/>
                              <Grid x:Name="ShapeGrid"/>
                            </StackPanel>
                          </StackPanel>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                          <Button x:Name="ApplyTermButton" Content="Apply term" FontWeight="SemiBold"/>
                          <Button x:Name="UndoTermButton" Content="Undo" ToolTip.Tip="Undo the last change (Ctrl+Z)"/>
                        </StackPanel>
                      </Grid>
                    </TabItem>

                    <!-- What the material does across a range -->
                    <TabItem Header="Response">
                      <DockPanel Margin="4">
                        <WrapPanel DockPanel.Dock="Top">
                          <TextBlock Text="from" VerticalAlignment="Center" Margin="0,0,4,4"/>
                          <TextBox x:Name="ResponseFromBox" Width="80" Margin="0,0,8,4"/>
                          <TextBlock Text="to" VerticalAlignment="Center" Margin="0,0,4,4"/>
                          <TextBox x:Name="ResponseToBox" Width="80" Margin="0,0,4,4"/>
                          <TextBlock x:Name="ResponseUnit" VerticalAlignment="Center" Margin="0,0,12,4"/>
                          <TextBlock Text="points" VerticalAlignment="Center" Margin="0,0,4,4"/>
                          <TextBox x:Name="ResponsePointsBox" Width="60" Text="401" Margin="0,0,12,4"/>
                          <ComboBox x:Name="ResponseQuantityBox" Width="250" Margin="0,0,8,4">
                            <ComboBoxItem Content="n and k along the principal axes"/>
                            <ComboBoxItem Content="one element of M"/>
                            <ComboBoxItem Content="principal-axis directions"/>
                          </ComboBox>
                          <ComboBox x:Name="ResponseRowBox" Width="70" Margin="0,0,4,4"/>
                          <ComboBox x:Name="ResponseColBox" Width="70" Margin="0,0,8,4"/>
                          <Button x:Name="ResponsePlotButton" Content="Plot" Margin="0,0,4,4"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" x:Name="ResponseChecks" TextWrapping="Wrap" Margin="0,4"/>
                        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
                          <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="M at" VerticalAlignment="Center"/>
                            <TextBox x:Name="ResponseAtBox" Width="80"/>
                            <TextBlock x:Name="ResponseAtUnit" VerticalAlignment="Center"/>
                          </StackPanel>
                          <SelectableTextBlock x:Name="ResponseMatrix" FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"/>
                        </StackPanel>
                        <local:SpectrumPlot x:Name="ResponsePlot" MinHeight="220"/>
                      </DockPanel>
                    </TabItem>

                    <!-- The material as the file writes it -->
                    <TabItem Header="Text">
                      <DockPanel Margin="4">
                        <TextBlock DockPanel.Dock="Top" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="The material as the stack file writes it: n, eps, no/ne, nx/ny/nz, a dispersion law, terms, or a model. docs/stack-format.md lists every form."/>
                        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                          <Button x:Name="ApplyMaterialButton" Content="Apply" FontWeight="SemiBold"/>
                          <Button x:Name="UndoMaterialButton" Content="Undo" ToolTip.Tip="Undo the last change (Ctrl+Z)"/>
                        </StackPanel>
                        <TextBox x:Name="MaterialSpecBox" AcceptsReturn="True" TextWrapping="NoWrap"
                                 FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"/>
                      </DockPanel>
                    </TabItem>
                  </TabControl>
                </TabItem>
              </TabControl>
            </DockPanel>
          </Grid>
        </TabItem>

        <!-- ===== The file ======================================================================= -->
        <TabItem Header="File">
          <DockPanel Margin="4">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="6" Margin="4">
              <Button x:Name="ApplyTextButton" Content="Apply" FontWeight="SemiBold"/>
              <Button x:Name="UndoTextButton" Content="Undo" ToolTip.Tip="Undo the last change (Ctrl+Z)"/>
              <TextBlock Classes="hint" VerticalAlignment="Center"
                         Text="The stack exactly as it is saved (docs/stack-format.md). Edit it here and Apply, or edit the tables and watch it follow."/>
            </StackPanel>
            <TextBox x:Name="Editor" AcceptsReturn="True" TextWrapping="NoWrap"
                     FontFamily="Cascadia Mono,Consolas,Menlo,DejaVu Sans Mono,monospace" FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
          </DockPanel>
        </TabItem>
      </TabControl>

      <GridSplitter Grid.Column="1" Width="5" ResizeDirection="Columns" Background="#EEE"/>

      <!-- Results -->
      <DockPanel Grid.Column="2" Margin="8">
        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
          <Button x:Name="EvaluateButton" Content="Evaluate (F5)" FontWeight="SemiBold" Margin="0,0,12,0"/>
          <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <CheckBox x:Name="ShowR" Content="R" IsChecked="True" Margin="0,0,8,0"/>
          <CheckBox x:Name="ShowT" Content="T" IsChecked="True" Margin="0,0,8,0"/>
          <CheckBox x:Name="ShowA" Content="A" Margin="0,0,20,0"/>
          <CheckBox x:Name="ShowP" Content="p (mode 0)" IsChecked="True" Margin="0,0,8,0"/>
          <CheckBox x:Name="ShowS" Content="s (mode 1)" IsChecked="True" Margin="0,0,8,0"/>
          <CheckBox x:Name="ShowMean" Content="mean" Margin="0,0,20,0"/>
          <CheckBox x:Name="ShowEllipsometry" Content="Ψ, Δ" Margin="0,0,12,0"/>
          <Button x:Name="MoreQuantitiesButton" Content="More…" Margin="0,0,12,0"/>
          <TextBlock Text="x:" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox x:Name="XAxisBox" Width="140" Margin="0,0,12,0"/>
          <TextBlock Text="view:" VerticalAlignment="Center" Margin="0,0,4,0"/>
          <ComboBox x:Name="ViewBox" Width="190" SelectedIndex="0">
            <ComboBoxItem Content="curves"/>
            <ComboBoxItem Content="Mueller matrix, reflection"/>
            <ComboBoxItem Content="Mueller matrix, transmission"/>
          </ComboBox>
        </WrapPanel>
        <TextBlock DockPanel.Dock="Top" x:Name="MoreQuantitiesText" Classes="hint" TextWrapping="Wrap" Margin="0,0,0,4"/>
        <Grid>
          <local:SpectrumPlot x:Name="Plot"/>
          <DockPanel x:Name="MuellerPanel" IsVisible="False">
            <TextBlock DockPanel.Dock="Bottom" x:Name="MuellerTitle" HorizontalAlignment="Center" Margin="0,4,0,0"/>
            <TextBlock DockPanel.Dock="Top" x:Name="MuellerLegend" TextWrapping="Wrap" Classes="hint" Margin="0,0,0,4"/>
            <UniformGrid x:Name="MuellerGrid" Rows="4" Columns="4"/>
          </DockPanel>
        </Grid>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
