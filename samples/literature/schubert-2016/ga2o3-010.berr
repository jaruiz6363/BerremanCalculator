        { "label": "Au-3", "lorentz": { "unit": "cm-1", "amplitude": 592.1, "center": 296.63, "gamma": 14.9 }, "axis": [0, 0, 1] },
        { "label": "Au-4", "lorentz": { "unit": "cm-1", "amplitude": 78, "center": 154.84, "gamma": 2.4 }, "axis": [0, 0, 1] },
        { "label": "free carriers, x (a)", "drude": { "unit": "cm-1", "plasma": 1058.3, "gamma": 370 }, "axis": [1, 0, 0] },
