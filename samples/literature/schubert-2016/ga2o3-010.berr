        { "label": "Bu-5", "lorentz": { "unit": "cm-1", "amplitude": 365.8, "center": 356.79, "gamma": 3.83 }, "axis_deg": 144 },
        { "label": "Bu-6", "lorentz": { "unit": "cm-1", "amplitude": 164.1, "center": 279.15, "gamma": 1.98 }, "axis_deg": 4 },
